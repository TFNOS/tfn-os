# The Waveshare ESP32-S3-Touch-AMOLED-1.75C. Use this file after sdkconfig.defaults, with its own build
# folder and sdkconfig (dev.ps1 am175 = build_dev/am175).
# ESP32-S3R8: 8 MB octal PSRAM (as the 3.49, sdkconfig.defaults), 32 MB flash.
CONFIG_TFN_TARGET_AMOLED175=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# The QSPI clock of the CO5300 (the Waveshare BSP uses 40 MHz; 80 MHz = the AMOLED-1.8, check the colours first)
CONFIG_TFN_LCD_PCLK_MHZ=80
# 32 MB: the slim app slots and a /data of 24.9 MB (partitions_am175.csv)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_am175.csv"
