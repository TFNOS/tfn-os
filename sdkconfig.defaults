CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
# The main task draws and also writes files (song saves)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# The board has 8 MB octal PSRAM (ESP32-S3R8)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Logs go to the native USB port (the COM port of the board)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# USB MIDI in the MIDI app (TinyUSB takes the USB PHY only while it is open)
CONFIG_TINYUSB_MIDI_COUNT=1

# 3 MB app + a FAT file system for exports, recordings and songs
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_FATFS_LFN_HEAP=y
# UTF-8 file names (BOOKS: Hebrew names of EPUB files on the SD card)
CONFIG_FATFS_API_ENCODING_UTF_8=y

# Two frame buffers and the WiFi/lwIP buffers are in PSRAM
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
# The apps' static state (main/linker.lf) and the WiFi/lwIP .bss go to PSRAM
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# A large cache with 64-byte lines: the apps draw into PSRAM
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_LINE_64B=y

# Bluetooth LE gamepad (bt_pad.c): NimBLE host with the HID service, one connection,
# bonds in NVS, the host memory in PSRAM
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_HID_SERVICE=y
CONFIG_BT_NIMBLE_BAS_SERVICE=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# BT KEYS: one HID service with 5 reports (gamepad, keyboard + its LEDs, media, mouse); 24 CCCDs
CONFIG_BT_NIMBLE_SVC_HID_MAX_RPTS=5
CONFIG_BT_NIMBLE_SVC_HID_MAX_INSTANCES=1
CONFIG_BT_NIMBLE_MAX_CCCDS=24

# the WebSocket of the WALKIE web page (web_walkie.c)
CONFIG_HTTPD_WS_SUPPORT=y
# the web password (main/web_auth.c) checks a WebSocket before its handshake
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y
# the sockets: 10 are too few. The web server uses up to 9 (7 connections, the listen socket, its
# control socket); with the LAN, the store, STOCKS or a WebSocket, the board refused new web connections
# ("httpd_accept_conn: error in accept (23)"): the manager page stayed at "loading the apps..."
CONFIG_LWIP_MAX_SOCKETS=16

# WireGuard (vpn.c): with PPP on, esp_netif keeps its data in netif client data, not in
# netif->state (the WireGuard netif uses state; else ESP-IDF 6.1 crashes in netif_add)
CONFIG_LWIP_PPP_SUPPORT=y
# OTA (main/ota.c): a new firmware that restarts before it marks itself good goes back to the old one
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# The idle power (main/power.c): DFS 240 / 80 MHz and the automatic light sleep with the screen off;
# the light sleep callbacks and the run time stats for the power report; no light sleep while a PC is on the USB
# port (the console); no CPU power down in light sleep (8.6 KB of internal RAM)
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
# CONFIG_PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP is not set
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
# STOCKS: finnhub.io sends GTS Root R4 cross-signed by the old GlobalSign Root CA (R1), which is
# not in the bundle; this checks a cross-signed root against the bundle too (about 700 bytes of heap)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
# STOCKS: the TLS buffers (16 + 4 KB) from malloc: PSRAM for 2 KB and more (SPIRAM_MALLOC_ALWAYSINTERNAL),
# small parts in the internal RAM. With INTERNAL_MEM_ALLOC an HTTPS link took the last internal RAM and the WiFi stopped
# the board (phy_track_pll_init: ESP_ERR_NO_MEM)
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
# The pools (main/tfn_pool.c): the PSA functions of the box key and of the beacons and the secrets. ChaCha20 and
# ChaCha20-Poly1305: PSA_WANT_KEY_TYPE_CHACHA20 and PSA_WANT_ALG_CHACHA20_POLY1305 (the PSA build then adds Poly1305).
# X25519 (PSA_ECC_FAMILY_MONTGOMERY, 255 bits): the curve and ECDH. A sdkconfig that has CHACHA20 "not set" gets it
# from force_cfg of boards.json.
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y
CONFIG_MBEDTLS_ECP_DP_CURVE25519_ENABLED=y
CONFIG_MBEDTLS_ECDH_C=y

# TFN OS: the app files (main/tfn_app.c, components/elf_loader). The loader links an app only to the ABI
# table of the firmware (main/tfn_abi.inc), not to its own libc and ESP-IDF tables.
CONFIG_ELF_LOADER=y
CONFIG_ELF_LOADER_LOAD_PSRAM=y
# CONFIG_ELF_LOADER_LIBC_SYMBOLS is not set
# CONFIG_ELF_LOADER_ESPIDF_SYMBOLS is not set
# the change of the flash layout over the air writes the partition table (main/layout.c)
CONFIG_SPI_FLASH_DANGEROUS_WRITE_ALLOWED=y
# the slim layout for all kinds: small app slots, a big /data (partitions_slim.csv)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_slim.csv"

