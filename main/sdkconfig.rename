CONFIG_ARCADE_BOARD_V1             CONFIG_TFN_BOARD_V1
CONFIG_ARCADE_BOARD_V2             CONFIG_TFN_BOARD_V2
CONFIG_ARCADE_LCD_PCLK_MHZ         CONFIG_TFN_LCD_PCLK_MHZ
CONFIG_ARCADE_BRIGHTNESS           CONFIG_TFN_BRIGHTNESS
CONFIG_ARCADE_VOLUME               CONFIG_TFN_VOLUME
