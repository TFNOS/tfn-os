 "modules": {
  "sdrfft": {"srcs": ["sdr_fft.c"], "about": "SDRFFT: the FFT and the windows of the radio tools (a leaf of the math: it knows no radio and no screen)"},
  "rfsrc": {"srcs": ["rfsrc.c", "rfsrc_native.c", "rfsrc_demo.c"], "uses": ["sdrfft"], "about": "RFSRC: the contract of a radio source (IQ blocks or a power sweep) and the sources: the native radio of the ESP32-S3 (main/rf_native.h), the demo signals", "psram": ["rfsrc_demo.c"]},
  "sdrdsp": {"srcs": ["sdr_spec.c", "sdr_trace.c", "sdr_wf.c", "sdr_chan.c"], "uses": ["rfsrc", "sdrfft"], "about": "SDRDSP: the measurement of a spectrum from a source (the plan of a sweep, the FFT, the detector), the traces, the waterfall and the persistence, the channel plans", "psram": ["sdr_spec.c", "sdr_trace.c"]},
  "rfdecode": {"srcs": ["rfdecode.c"], "about": "RFDECODE: the slicer of a pulse stream into packets and the decoders (RCSwitch protocols 1..12, PWM, PPM, Manchester, NRZ), and the encoders; pure C", "psram": ["rfdecode.c"]},
  "tfncomp": {"srcs": ["tfncomp.c", "tc_x25519.c", "tc_master.c", "tc_ir.c"], "uses": ["irdecode"], "about": "TFNCOMP: the protocol of the TFN COMPANIONS (small ESP32 boards with no screen: companion/): the frames, the X25519 pairing, the SipHash tag and counter, the parts of long frames, the pin tables of the chips, the master side (tc_master.c) and the IR plan of a button (tc_ir.c); main/companion.c is the service of the apps; pure C", "psram": ["tc_master.c"]},
  "irdecode": {"srcs": ["irdecode.c"], "about": "IRDECODE: the slicer of an infrared stream into frames, the decoders in the style of IRremote (NEC, SAMSUNG, SONY, RC5, RC6, PANASONIC / KASEIKYO, LG, JVC, DENON, SHARP, BOSEWAVE, WHYNTER, the universal pulse distance / width decoder, the hash of an unknown frame) and the encoders; pure C", "psram": ["irdecode.c"]},
  "rfpulse": {"srcs": ["rfpulse.c", "rfp_gpio.c", "rfp_demo.c", "rfp_irdemo.c", "rfp_irtx.c", "rfp_board.c"], "uses": ["rfdecode", "irdecode"], "about": "RFPULSE: the contract of a pulse receiver (a 315 / 433 MHz module or an IR receiver module on a pin) and the receivers: the modules on the free pins of each board, the demos; the IR LED (RMT); the wiring of each board", "psram": ["rfp_demo.c", "rfp_irdemo.c"]},
  "duo": {"srcs": ["duo.c"], "about": "the two end buttons of the two-player games on one board"},
  "toon": {"srcs": ["toon.c", "toon_stage.c"], "about": "TOON: the rasterizer, the cartoon puppets and the rooftop stage (FIGHT, QUEST)", "psram": ["toon.c"]},
  "strokefont": {"srcs": ["strokefont.c"], "about": "the stroke font (TUNER, METRO)"},
  "duel": {"srcs": ["duel.c"], "about": "the match of two boards for the turn games (CHESS, SEA BATTLE)", "psram": ["duel.c"]},
  "drumkit": {"srcs": ["drumkit.c"], "about": "the drum sounds from synth voices"},
  "instr": {"srcs": ["instr.c"], "about": "the synth instruments and the General MIDI maps (STUDIO, MIDI_BG)"},
  "midi_bg": {"srcs": ["midi_bg.c", "bgn.c"], "uses": ["instr", "drumkit"], "about": "MIDI_BG: the background music from MIDI files (BGN notes)", "psram": ["midi_bg.c"]},
  "tfphys": {"srcs": ["tfphys.c"], "about": "TFPHYS: 2D rigid bodies for the store games (sequential impulses as in Box2D Lite; joints that break, fracture, particles, events: GLASSHOUSE, GUMMY SIEGE)", "psram": ["tfphys.c"]},
  "tfsfx": {"srcs": ["tfsfx.c"], "about": "TFSFX: the MP3 sound effects of a store app from its data on the SD card (sdk/docs/sound.md; it has the minimp3 code)", "psram": ["tfsfx.c"]},
  "scn": {"srcs": ["scn.c"], "about": "the pixel-art engine of SCENES (STATION X uses it too)", "psram": ["scn.c"]},
  "zstd": {"srcs": ["zstddeclib.c"], "about": "ZSTD: the zstd decoder (Zstandard 1.5.6, BSD; the single-file decoder of the release, third_party/zstd/README.md)", "psram": ["zstddeclib.c"]},
  "zimread": {"srcs": ["zimread.c"], "uses": ["zstd"], "about": "ZIMREAD: the reader of ZIM files (the offline Wikipedia of Kiwix) on the SD card: the entries, the title search, the zstd clusters in PSRAM, split parts (WIKI)", "psram": ["zimread.c"]},
  "tfnet": {"srcs": ["tfnet.c"], "about": "TFNET: a small HTTP and HTTPS client (lwip sockets, esp_tls with the shared root certificates or the roots of the app) and a JSON reader (WEATHER, ON AIR, HOME FRONT, MQTT, GMAIL, REDDIT, TELEGRAM)"},
  "tfmqtt": {"srcs": ["tfmqtt.c", "mq_broker.c"], "about": "TFMQTT: MQTT 3.1.1 as state machines with no sockets: the packets, the topic rules, a client and a broker (MQTT); pure C"}
 },
