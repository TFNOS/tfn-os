# The Seeed SenseCAP Watcher. Use this file after sdkconfig.defaults, with its own build folder
# and sdkconfig:
#   idf.py -B build_wt -D SDKCONFIG=sdkconfig.wt
#          -D "SDKCONFIG_DEFAULTS=sdkconfig.defaults;sdkconfig.defaults.watcher" build
# 32 MB flash (the build uses 16 MB, the same partition table as the other boards) and 8 MB
# octal PSRAM, as the 3.49 (sdkconfig.defaults).
CONFIG_TFN_TARGET_WATCHER=y

# The QSPI clock of the SPD2010 (the Seeed BSP uses 40 MHz)
CONFIG_TFN_LCD_PCLK_MHZ=40

# The console and the log: UART0 (GPIO43/44) through the CH342 USB-UART chip. The
# USB-C port of the Watcher does not go to the USB of the ESP32-S3.
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
# the slim layout: small app slots, a big /data for the app files (partitions_slim.csv)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_slim.csv"
